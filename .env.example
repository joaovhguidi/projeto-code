# API
PORT=3333
NODE_ENV=development
APP_URL=http://localhost:5173
# Conexão usada pela API (papel sem privilégios de dono -> RLS ativo)
DATABASE_URL=postgres://nexo_app:nexo_app_dev@localhost:5432/nexo
# Conexão usada nas migrações (dono das tabelas)
MIGRATION_DATABASE_URL=postgres://nexo_owner:nexo_owner_dev@localhost:5432/nexo
# Testes
TEST_DATABASE_URL=postgres://nexo_app:nexo_app_dev@localhost:5432/nexo_test
TEST_MIGRATION_DATABASE_URL=postgres://nexo_owner:nexo_owner_dev@localhost:5432/nexo_test
# Diretório privado para documentos enviados (fora da pasta pública)
STORAGE_DIR=./storage
# E-mail (opcional). Sem SMTP configurado, a recuperação de senha informa
# na interface que o envio não está disponível.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexo Business <nao-responda@nexo.app>"
